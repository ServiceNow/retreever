"""Local paths for ReTreever.

Copy this file to ``local_paths.py`` (next to it in the repo root) and edit
the values below for your machine. ``local_paths.py`` is gitignored, so any
paths you put in it stay private and won't be committed.

ReTreever resolves *all* on-disk locations (Hugging Face cache + per-dataset
directories) through this single module. If you add a new dataset, register
its on-disk location here.
"""

# Hugging Face cache directory used by the encoders and dataset loaders.
# Set to None to fall back to the default HF cache (~/.cache/huggingface).
HF_CACHE_DIR = None

# Per-dataset on-disk locations. Keys must match the dataset names recognized
# by ``scripts/train.py``; values are the absolute path to the directory that
# the corresponding ReTreever loader expects.  Use ``scripts/data_prep/*.py``
# to produce these directories from the original sources.
DATA_PATHS = {
    "hotpotqa": "/path/to/hotpotqa",
    "topiocqa": "/path/to/topiocqa",
    "repliqa": "/path/to/repliqa",
    "imagenet1k": "/path/to/imagenet1k",
    "voxceleb2": "/path/to/voxceleb2",
    # Modality-gap paper datasets (scripts/data_prep/modality_gap/): each directory holds the HF DatasetDict
    # ("dataset", or "dataset_augmented" for clotho_augmented) next to the audio/ or images/ files.
    # "clotho": "/path/to/clotho",
    # "clotho_augmented": "/path/to/clotho",            # same directory as clotho
    # "sounddescs": "/path/to/sounddescs",
    # "audiocaps": "/path/to/audiocaps",
    # "coco": "/path/to/coco",
    # "flickr30k": "/path/to/flickr30k",
    # Optional: pre-computed CLAP mel features (preprocess_*.py); default is "<dataset>_<encoder>" next to the dataset
    # "clotho_augmented_clap-fused-ta": "/path/to/clotho_augmented_clap-fused-ta",
    # Add your own datasets here, e.g.:
    # "my_dataset": "/path/to/my_dataset",
}
